# Avatar Workshop System - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Avatar Provider API Keys (choose one or both)
# ===========================================

# D-ID (https://www.d-id.com/)
# Plans: Lite $5.90/mo (10 min), Advanced $108/mo (100 min + AI Agents)
DID_API_KEY=your_did_api_key_here
DID_BASE_URL=https://api.d-id.com

# HeyGen (https://www.heygen.com/)
# Plans: Creator $29/mo (unlimited video), API Pro $99/mo (100 credits)
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_BASE_URL=https://api.heygen.com

# Workshop-specific HeyGen settings (run `python heygen_workshop.py --discover` to find these)
HEYGEN_AVATAR_ID=your_avatar_id_from_discover
HEYGEN_VOICE_ID=your_elevenlabs_voice_id_from_discover

# Set to 'true' to test pipeline without making API calls
HEYGEN_TEST_MODE=false

# ===========================================
# LLM Configuration (for RAG-based Q&A)
# ===========================================

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4-turbo-preview

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===========================================
# Vector Database (for knowledge base storage)
# ===========================================

# Pinecone (https://www.pinecone.io/)
# Free tier available with 1 index
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=avatar-workshop

# ===========================================
# Storage Configuration
# ===========================================

# Local storage (for development)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data

# S3 storage (for production)
# STORAGE_TYPE=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_MAX=100
