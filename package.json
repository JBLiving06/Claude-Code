{
  "name": "avatar-workshop-system",
  "version": "1.0.0",
  "description": "Avatar-Led Interactive Workshop System with AI-powered Q&A",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w @avatar-workshop/server",
    "dev:client": "npm run dev -w @avatar-workshop/client",
    "build": "npm run build -w @avatar-workshop/server && npm run build -w @avatar-workshop/client",
    "start": "npm run start -w @avatar-workshop/server",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
